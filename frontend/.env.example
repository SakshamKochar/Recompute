# Copy to .env.local and adjust. Nothing here is secret; every VITE_ value ends up in browser code.

# Where the browser sends API requests. The default "/api" goes through the Vite dev proxy below,
# so no CORS setup is needed in development. For a static build served separately from the API,
# set the full origin, e.g. https://recompute-api.example.com (and add the site to the API's CORS_ORIGINS).
VITE_API_BASE=/api

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# auto: use Live mode when the API answers /health, otherwise ask the user (never switches silently).
# live | demo: start in that mode.
VITE_DEFAULT_MODE=auto

# Dev server only (not exposed to the browser).
RECOMPUTE_API_PROXY_TARGET=http://127.0.0.1:8000
RECOMPUTE_WEB_PORT=5274
